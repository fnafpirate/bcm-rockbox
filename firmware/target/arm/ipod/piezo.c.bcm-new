#include "thread.h"
#include "system.h"
#include "kernel.h"
#include "usb.h"
#include "logf.h"
#include "piezo.h"
#ifdef HAVE_BCM_VIDEOCORE
#include "pcm_sink.h"
#include "pcm_sampr.h"
#endif

static long piezo_stack[DEFAULT_STACK_SIZE/sizeof(long)];
static const char piezo_thread_name[] = "piezo";
static struct event_queue piezo_queue;
static unsigned int duration;
static bool beeping;

enum {
    Q_PIEZO_BEEP = 1,
    Q_PIEZO_BEEP_FOR_TICK,
    Q_PIEZO_BEEP_FOR_USEC,
    Q_PIEZO_STOP
};

static inline void piezo_hw_init(void)
{
#ifndef SIMULATOR
    /*logf("PIEZO: hw_init");*/
    DEV_INIT1 &= ~0xc;
    DEV_EN |= DEV_PWM;
#endif
}

static void piezo_hw_tick(unsigned int form_and_period)
{
#ifndef SIMULATOR
    PWM0_CTRL = 0x80000000 | form_and_period;
#endif
}

static inline void piezo_hw_stop(void)
{
#ifndef SIMULATOR
    PWM0_CTRL = 0;
#endif
}

static void piezo_thread(void)
{
    struct queue_event ev;
    long piezo_usec_off;

    while(1)
    {
        queue_wait(&piezo_queue, &ev);
        switch(ev.id)
        {
            case Q_PIEZO_BEEP:
                piezo_hw_tick((unsigned int)ev.data);
                beeping = true;
                break;
            case Q_PIEZO_BEEP_FOR_TICK:
                piezo_hw_tick((unsigned int)ev.data);
                beeping = true;
                sleep(duration);
                if (beeping)
                    piezo_hw_stop();
                beeping = false;
                /* remove anything that appeared while sleeping */
                queue_clear(&piezo_queue);
                break;
            case Q_PIEZO_BEEP_FOR_USEC:
                piezo_usec_off = USEC_TIMER + duration;
                piezo_hw_tick((unsigned int)ev.data);
                beeping = true;
                while (TIME_BEFORE(USEC_TIMER, piezo_usec_off))
                    if (duration >= 5000) yield();
                if (beeping)
                    piezo_hw_stop();
                beeping = false;
                /* remove anything that appeared while sleeping */
                queue_clear(&piezo_queue);
                break;
            case Q_PIEZO_STOP:
                if (beeping)
                    piezo_hw_stop();
                beeping = false;
                break;
#ifndef SIMULATOR
            case SYS_USB_CONNECTED:
                /*logf("USB: Piezo core");*/
                piezo_hw_stop();
                queue_clear(&piezo_queue);
                usb_acknowledge(SYS_USB_CONNECTED_ACK, ev.data);
                usb_wait_for_disconnect(&piezo_queue);
                break ;
#endif
            case SYS_TIMEOUT:
                break;
        }
        yield();
    }
}


void piezo_play(unsigned short inv_freq, unsigned char form)
{
    queue_post(&piezo_queue, Q_PIEZO_BEEP,
        (intptr_t)((unsigned int)form << 16 | inv_freq));
}

void piezo_play_for_tick(unsigned short inv_freq,
                    unsigned char form, unsigned int dur)
{
    duration = dur;
    queue_post(&piezo_queue, Q_PIEZO_BEEP_FOR_TICK,
        (intptr_t)((unsigned int)form << 16 | inv_freq));
}

void piezo_play_for_usec(unsigned short inv_freq,
                    unsigned char form, unsigned int dur)
{
    duration = dur;
    queue_post(&piezo_queue, Q_PIEZO_BEEP_FOR_USEC,
        (intptr_t)((unsigned int)form << 16 | inv_freq));
}

void piezo_stop(void)
{
    queue_post(&piezo_queue, Q_PIEZO_STOP, 0);
}

void piezo_clear(void)
{
    queue_clear(&piezo_queue);
    piezo_stop();
}

bool piezo_busy(void)
{
    return !queue_empty(&piezo_queue);
}

/*  conversion factor based on the following data

        period          Hz
        10              8547
        20              4465
        30              3024
        40              2286
        50              1846
        60              1537
        70              1320
        80              1165
        90              1030
        100             928

    someone with better recording/analysing equipment should be able
    to get more accurate figures
*/
unsigned int piezo_hz(unsigned int hz)
{
    if (hz > 0)
        return 91225/hz;
    else
        return 0;
}

void piezo_init(void)
{
    /*logf("PIEZO: init");*/
    piezo_hw_init();
    queue_init(&piezo_queue, true);
    create_thread(piezo_thread, piezo_stack, sizeof(piezo_stack), 0,
            piezo_thread_name IF_PRIO(, PRIORITY_REALTIME)
            IF_COP(, CPU));
}

void piezo_button_beep(bool beep, bool force)
{
    /* old on clickwheel action - piezo_play_for_usec(50, 0x80, 400);
       old on button action - piezo_play_for_usec(50, 0x80, 3000); */

    if (force)
        piezo_clear();

    if (queue_empty(&piezo_queue))
    {
        if (beep)
            piezo_play_for_tick(40, 0x80, HZ/5);
        else
            piezo_play_for_usec(91, 0x80, 4000);
    }
}

/*
 * bcm-rockbox: PWM0 click-speaker PCM sink at 22 kHz
 * =====================================================
 * PWM0 sits at 0x7000A000 on PP5022.  One period of PWM at 22 kHz:
 *   PCLK = 24 MHz → period_ticks = 24000000 / 22050 ≈ 1088.
 * We drive it as a 10-bit DAC by writing:
 *   PWM0_CTRL = 0x80000000 | (duty << 11) | 0x43F
 * where duty is 0..1023 (10-bit sample).
 *
 * Bass cut (high-pass IIR, fc ≈ 500 Hz):
 *   y[n] = alpha * (y[n-1] + x[n] - x[n-1])
 *   alpha = 1 - 2*pi*fc/fs ≈ 0.857  → Q16: 56144
 *
 * Automatic Loudness: boost low amplitudes below threshold.
 * Noise shaping: carry quantisation error forward (1st-order).
 *
 * pcm_sink_write() is called by the PCM layer at 22050 Hz.
 * It is registered as a PCM sink during piezo playback only.
 */

#ifndef SIMULATOR
#define PWM0_PERIOD_TICKS   0x43F  /* 24 MHz / 22050 Hz - 1 ≈ 1087 */
#define BASS_CUT_ALPHA_Q16  56144  /* 0.857 × 65536 */
#define LOUDNESS_THRESH     (1 << 10) /* 10% of full scale */
#define LOUDNESS_GAIN_Q8    384    /* 1.5× boost */

static int  pcm_sink_prev_x = 0;    /* bass-cut: last input  */
static int  pcm_sink_prev_y = 0;    /* bass-cut: last output */
static int  pcm_sink_ns_err = 0;    /* noise-shaping error   */
static bool pcm_sink_active = false;

/* Apply bass-cut high-pass, automatic loudness, noise-shaping, then
 * write one sample to PWM0.  sample is 16-bit signed PCM. */
static inline void pcm_sink_write_sample(int sample)
{
#ifdef HAVE_BCM_VIDEOCORE
    /* 0. Volume scaling (Q8) — track headphone level */
    sample = (sample * pcm_sink_vol_q8) >> 8;
#endif
    /* 1. Bass cut (high-pass IIR, 500 Hz cut-off) */
    int raw = sample + pcm_sink_prev_x - pcm_sink_prev_y;
    pcm_sink_prev_x = sample;
    int y = (BASS_CUT_ALPHA_Q16 * raw) >> 16;
    pcm_sink_prev_y = y;

    /* 2. Automatic Loudness: boost quiet signals */
    int abs_y = y < 0 ? -y : y;
    if (abs_y < LOUDNESS_THRESH)
        y = (y * LOUDNESS_GAIN_Q8) >> 8;

    /* 3. Noise shaping: add previous error, then requantise to 10-bit */
    int shaped = y + pcm_sink_ns_err;
    int duty   = (shaped >> 6) + 512;  /* map [-32768..32767] → [0..1023] */
    if (duty < 0)   duty = 0;
    if (duty > 1023) duty = 1023;

    /* Carry quantisation error forward */
    pcm_sink_ns_err = shaped - ((duty - 512) << 6);

    /* 4. Write to PWM0 */
    PWM0_CTRL = 0x80000000 | (duty << 11) | PWM0_PERIOD_TICKS;
}

/* PCM sink callback — called by audio DMA at 22050 Hz with stereo 16-bit */
void piezo_pcm_sink(const void *buf, int size)
{
    if (!pcm_sink_active)
        return;

    const int16_t *p = (const int16_t *)buf;
    int n = size / 4;   /* stereo 16-bit frames */
    while (n--)
    {
        /* Mix L+R, divide by 2 to prevent clipping */
        int mono = ((int)p[0] + (int)p[1]) >> 1;
        p += 2;
        pcm_sink_write_sample(mono);
    }
}

/* Activate the PCM sink (called when starting a beep in PCM mode) */
void piezo_pcm_sink_enable(bool enable)
{
    pcm_sink_active = enable;
    if (!enable)
    {
        /* Reset IIR and noise-shaper state */
        pcm_sink_prev_x = 0;
        pcm_sink_prev_y = 0;
        pcm_sink_ns_err = 0;
        PWM0_CTRL = 0;
    }
}

#ifdef HAVE_BCM_VIDEOCORE
/* Volume scaling factor (Q8): updated by audiohw_set_volume() */
static int pcm_sink_vol_q8 = 256; /* default: unity gain */

/* Called by wm8758.c when headphone volume changes.
 * vol_l, vol_r are in tenth-dBs (negative = attenuation).
 * We use the average channel and map 0 dB → Q8=256, linearly. */
void piezo_set_volume(int vol_l_tdb, int vol_r_tdb)
{
    /* Average both channels */
    int avg_tdb = (vol_l_tdb + vol_r_tdb) / 2;

    /* Map: 0 tdb = unity (Q8 256), -600 tdb = silence (Q8 0).
     * Clamp above 0 dB to unity. */
    if (avg_tdb >= 0)
        pcm_sink_vol_q8 = 256;
    else if (avg_tdb <= -600)
        pcm_sink_vol_q8 = 0;
    else
        pcm_sink_vol_q8 = 256 + (avg_tdb * 256) / 600; /* linear approx */
}

/* Register the click-speaker as a PCM sink with the audio layer.
 * Safe to call multiple times — no-op if already active. */
void piezo_register_pcm_sink(void)
{
    if (!pcm_sink_active)
    {
        pcm_sink_active = true;
        /* Reset filter / noise-shaper state on each fresh registration */
        pcm_sink_prev_x = 0;
        pcm_sink_prev_y = 0;
        pcm_sink_ns_err = 0;
        DEV_EN |= DEV_PWM;   /* make sure PWM clock is on */
    }
}

/* Unregister the click-speaker PCM sink and silence the PWM output. */
void piezo_unregister_pcm_sink(void)
{
    piezo_pcm_sink_enable(false); /* resets state and clears PWM0_CTRL */
}

/* pcm_sink descriptor: 22050 Hz only, hardware-volume (PWM duty) */
static const unsigned long piezo_sink_samprs[] = { SAMPR_22 };

static void piezo_sink_init(void)    { piezo_hw_init(); }
static void piezo_sink_postinit(void){ }
static void piezo_sink_set_freq(uint16_t freq) { (void)freq; }
static void piezo_sink_lock(void)    { }
static void piezo_sink_unlock(void)  { }
static void piezo_sink_play(const void *addr, size_t size)
    { piezo_pcm_sink(addr, (int)size); }
static void piezo_sink_stop(void)
    { piezo_pcm_sink_enable(false); }

struct pcm_sink piezo_pcm_sink_desc = {
    .caps = {
        .samprs       = piezo_sink_samprs,
        .num_samprs   = 1,
        .default_freq = SAMPR_22,
        .volume_type  = PCM_SINK_HWVOL,
    },
    .ops = {
        .init      = piezo_sink_init,
        .postinit  = piezo_sink_postinit,
        .set_freq  = piezo_sink_set_freq,
        .lock      = piezo_sink_lock,
        .unlock    = piezo_sink_unlock,
        .play      = piezo_sink_play,
        .stop      = piezo_sink_stop,
    },
};
#endif /* HAVE_BCM_VIDEOCORE */

#else /* SIMULATOR */
void piezo_pcm_sink(const void *buf, int size)   { (void)buf; (void)size; }
void piezo_pcm_sink_enable(bool enable)           { (void)enable; }
#ifdef HAVE_BCM_VIDEOCORE
void piezo_set_volume(int vol_l_tdb, int vol_r_tdb)
    { (void)vol_l_tdb; (void)vol_r_tdb; }
void piezo_register_pcm_sink(void)   { }
void piezo_unregister_pcm_sink(void) { }
#endif /* HAVE_BCM_VIDEOCORE */
#endif /* SIMULATOR */
